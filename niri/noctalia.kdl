layout {

    focus-ring {
        active-color   "#e46789"
        inactive-color "#29141a"
        urgent-color   "#b94363"
    }

    border {
        active-color   "#e46789"
        inactive-color "#29141a"
        urgent-color   "#b94363"
    }

    shadow {
        color "#29141a70"
    }

    tab-indicator {
        active-color   "#e46789"
        inactive-color "#8d0c2f"
        urgent-color   "#b94363"
    }

    insert-hint {
        color "#e4678980"
    }
}

recent-windows {
    highlight {
        active-color "#e46789"
        urgent-color "#b94363"
    }
}
