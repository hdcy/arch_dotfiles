layout {

    focus-ring {
        active-color   "#b267e4"
        inactive-color "#220d30"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#b267e4"
        inactive-color "#220d30"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#b267e4"
        inactive-color "#581485"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#b267e480"
    }
}

recent-windows {
    highlight {
        active-color "#b267e4"
        urgent-color "#fd4663"
    }
}
